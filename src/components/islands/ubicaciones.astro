<script is:client="load">
  document.addEventListener("DOMContentLoaded", () => {
    let activeIndex = 0;
    let limit = 0;
    let disabled = false;

    const SPIN_FORWARD_CLASS = "js-spin-fwd";
    const SPIN_BACKWARD_CLASS = "js-spin-bwd";
    const DISABLE_TRANSITIONS_CLASS = "js-transitions-disabled";
    const SPIN_DUR = 1000;

    const stage = document.querySelector(".carousel__stage");
    const controlContainer = document.querySelector(".carousel__control");
    const spinnerLeft = document.querySelector(".spinner--left");

    if (!spinnerLeft) {
      console.error("No se encontró .spinner--left");
      return;
    }

    const faces = spinnerLeft.querySelectorAll(".spinner__face");
    limit = faces.length;

    faces.forEach((face, i) => {
      face.dataset.index = i;
    });

    /* 🔁 Clonar spinner */
    const spinnerRight = spinnerLeft.cloneNode(true);
    spinnerRight.classList.remove("spinner--left");
    spinnerRight.classList.add("spinner--right");

    spinnerLeft.parentElement.appendChild(spinnerRight);

    /* 🎯 Controles */
    for (let i = 0; i < limit; i++) {
      const a = document.createElement("a");
      a.href = "#";
      a.dataset.index = i;
      if (i === 0) a.classList.add("active");
      controlContainer.appendChild(a);
    }

    const controls = controlContainer.querySelectorAll("a");

    function spin(inc) {
      if (disabled) return;

      activeIndex += inc;
      if (activeIndex >= limit) activeIndex = 0;
      if (activeIndex < 0) activeIndex = limit - 1;

      disabled = true;

      document
        .querySelectorAll(`.spinner__face[data-index="${activeIndex}"]`)
        .forEach((el) => el.classList.add("js-next"));

      stage.classList.add(inc > 0 ? SPIN_FORWARD_CLASS : SPIN_BACKWARD_CLASS);

      controls.forEach((c) => c.classList.remove("active"));
      controls[activeIndex].classList.add("active");

      setTimeout(spinCallback, SPIN_DUR);
    }

    function spinCallback() {
      document
        .querySelectorAll(".js-active")
        .forEach((el) => el.classList.remove("js-active"));

      document.querySelectorAll(".js-next").forEach((el) => {
        el.classList.remove("js-next");
        el.classList.add("js-active");
        el.parentElement.prepend(el);
      });

      stage.classList.add(DISABLE_TRANSITIONS_CLASS);
      stage.classList.remove(SPIN_FORWARD_CLASS, SPIN_BACKWARD_CLASS);

      setTimeout(() => {
        stage.classList.remove(DISABLE_TRANSITIONS_CLASS);
        disabled = false;
      }, 100);
    }

    /* ⌨️ Teclado */
    window.addEventListener("keydown", (e) => {
      if (e.key === "ArrowUp") spin(-1);
      if (e.key === "ArrowDown") spin(1);
    });

    /* 🖱️ Click controles */
    controls.forEach((ctrl) => {
      ctrl.addEventListener("click", (e) => {
        e.preventDefault();
        spin(ctrl.dataset.index - activeIndex);
      });
    });
  });
</script>
