---
const pathname = Astro.url.pathname;
const uberEats =
  "https://www.ubereats.com/store/brooklyn-burgers-costa-verde/Ma4UE0ftU6mU4G8LMrB9-g?diningMode=DELIVERY";
---

<nav class="nav">
  <div class="contenedor">
    <div class="nav__barra">
      <div class="nav__barra--logo">
        <a href="/">
          <img src="/images/brooklyn.jpg" alt="Logo Brooklyn" loading="lazy" />
        </a>
      </div>

      <div id="nav" class="nav__barra--enlaces">
        <div class="nav__barra--enlaces--links">
          <div class="nav__barra--logo-enlace">
            <a href="/">
              <img
                src="/images/brooklyn.jpg"
                alt="Logo Brooklyn"
                loading="lazy"
              />
            </a>
          </div>

          <div class="nav__barra--enlaces--links-enlace">
            <a class={`nav__item ${pathname === "/" ? "activo" : ""}`} href="/">
              Inicio
            </a>
          </div>

          <div class="nav__barra--enlaces--links-enlace">
            <a
              class={`nav__item ${pathname === "/nosotros" ? "activo" : ""}`}
              href="/nosotros"
            >
              Nosotros
            </a>
          </div>

          <div class="nav__barra--enlaces--links-enlace">
            <a
              class={`nav__item ${pathname === "/menu" ? "activo" : ""}`}
              href="/menu"
            >
              Menú
            </a>
          </div>

          <div class="nav__barra--enlaces--links-enlace">
            <a href={uberEats} target="_blank" rel="noopener noreferrer">
              Uber Eats
            </a>
          </div>
        </div>
      </div>

      <button id="button-menu" class="button-menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</nav>

<script is:client="load">
  const toggleButton = document.getElementById("button-menu");
  const links = document.querySelectorAll("nav__barra--enlaces--links");
  const navMenu = document.getElementById("nav");

  toggleButton.addEventListener("click", () => {
    toggleButton.classList.toggle("close");
    navMenu.classList.toggle("show");
  });

  //Cierra menú al hacer clic fuera del menú
  navMenu.addEventListener("click", (e) => {
    if (e.target.id === "nav") {
      navMenu.classList.remove("show");
      toggleButton.classList.remove("close");
    }
  });

  // Cierra el menú cuando se hace clic en un enlace
  links.forEach((link) => {
    link.addEventListener("click", () => {
      nav.classList.remove("active");
      buttonMenu.classList.remove("active");
    });
  });
</script>
