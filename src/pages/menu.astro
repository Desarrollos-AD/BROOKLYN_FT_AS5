---
import Layout from "../layouts/layout.astro";
import Nav from "../components/islands/navIsla.astro";

import productos from "../data/hamburguesas.json";
---

<Layout titulo="Menú">
  <Nav />
  <header class="header__menu">
    <div class="header__glass">
      <div class="content">
        <div class="bg-shape"></div>

        {
          productos.map((producto) => (
            <div class="product-img">
              <div class="product-img__item" id={`img${producto.id}`}>
                <img
                  src={producto.imagen_sf}
                  alt={`Imagen ${producto.titulo}`}
                  class="product-img__img"
                  width="900"
                  height="800"
                  loading="lazy"
                />
              </div>
            </div>
          ))
        }

        <div class="product-slider">
          <button class="prev disabled">
            <span class="icon">
              <svg class="icon icon-arrow-right">
                <use xlink:href="#icon-arrow-left"></use>
              </svg>
            </span>
          </button>
          <button class="next">
            <span class="icon">
              <svg class="icon icon-arrow-right">
                <use xlink:href="#icon-arrow-right"></use>
              </svg>
            </span>
          </button>

          <div class="product-slider__wrp swiper-wrapper">
            {
              productos.map((producto) => (
                <div
                  class="product-slider__item swiper-slide"
                  data-target={`img${producto.id}`}
                  key={producto.id}
                >
                  <div class="product-slider__card">
                    <div class="product-slider__content">
                      <span class="product-slider__price">
                        {producto.precio}
                      </span>

                      <h1 class="product-slider__title">{producto.titulo}</h1>

                      <div class="product-ctr">
                        <div class="product-labels">
                          <div class="product-labels__title">
                            <p>{producto.descripcion}</p>
                          </div>
                        </div>
                      </div>

                      <div class="product-slider__bottom">
                        <a
                          href={producto.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="product-slider__cart"
                        >
                          Pídela en Uber Eats
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <svg class="hidden" hidden>
        <symbol id="icon-arrow-left" viewBox="0 0 32 32">
          <path
            d="M0.704 17.696l9.856 9.856c0.896 0.896 2.432 0.896 3.328 0s0.896-2.432 0-3.328l-5.792-5.856h21.568c1.312 0 2.368-1.056 2.368-2.368s-1.056-2.368-2.368-2.368h-21.568l5.824-5.824c0.896-0.896 0.896-2.432 0-3.328-0.48-0.48-1.088-0.704-1.696-0.704s-1.216 0.224-1.696 0.704l-9.824 9.824c-0.448 0.448-0.704 1.056-0.704 1.696s0.224 1.248 0.704 1.696z"
          ></path>
        </symbol>
        <symbol id="icon-arrow-right" viewBox="0 0 32 32">
          <path
            d="M31.296 14.336l-9.888-9.888c-0.896-0.896-2.432-0.896-3.328 0s-0.896 2.432 0 3.328l5.824 5.856h-21.536c-1.312 0-2.368 1.056-2.368 2.368s1.056 2.368 2.368 2.368h21.568l-5.856 5.824c-0.896 0.896-0.896 2.432 0 3.328 0.48 0.48 1.088 0.704 1.696 0.704s1.216-0.224 1.696-0.704l9.824-9.824c0.448-0.448 0.704-1.056 0.704-1.696s-0.224-1.248-0.704-1.664z"
          ></path>
        </symbol>
      </svg>
    </div>
  </header>

  <script
    is:raw
    src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.1.0/jquery.min.js"
  ></script>
  <script
    is:raw
    src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

  <section>
    <div class="contenedor">
      <figure>
        <img src="../../public/images/menu_3.jpg" alt="Figura menú" />
        <img src="../../public/images/menu_1.jpg" alt="Figura menú" />
        <img src="../../public/images/menu_2.jpg" alt="Figura menú" />
        <img src="../../public/images/menu_4.jpg" alt="Figura menú" />
        <img src="../../public/images/menu_5.jpg" alt="Figura menú" />
        <img src="../../public/images/menu_7.jpg" alt="Figura menú" />

        <figcaption>Menú Brooklyn</figcaption>
      </figure>
    </div>
  </section>
</Layout>

<script is:client="load">
  var swiper = new Swiper(".product-slider", {
    spaceBetween: 30,
    effect: "fade",
    // initialSlide: 2,
    loop: false,
    navigation: {
      nextEl: ".next",
      prevEl: ".prev",
    },
    // mousewheel: {
    //     // invert: false
    // },
    on: {
      init: function () {
        var index = this.activeIndex;

        var target = $(".product-slider__item").eq(index).data("target");

        console.log(target);

        $(".product-img__item").removeClass("active");
        $(".product-img__item#" + target).addClass("active");
      },
    },
  });

  swiper.on("slideChange", function () {
    var index = this.activeIndex;

    var target = $(".product-slider__item").eq(index).data("target");

    console.log(target);

    $(".product-img__item").removeClass("active");
    $(".product-img__item#" + target).addClass("active");

    if (swiper.isEnd) {
      $(".prev").removeClass("disabled");
      $(".next").addClass("disabled");
    } else {
      $(".next").removeClass("disabled");
    }

    if (swiper.isBeginning) {
      $(".prev").addClass("disabled");
    } else {
      $(".prev").removeClass("disabled");
    }
  });

  $(".js-fav").on("click", function () {
    $(this).find(".heart").toggleClass("is-active");
  });
</script>
